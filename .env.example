# ==============================================================================
# MessHub Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# NOTE: Never commit your actual .env or service-role keys to GitHub.
# ==============================================================================

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anon / Public Key (Safe for mobile client use)
SUPABASE_ANON_KEY=your-supabase-anon-key-here
